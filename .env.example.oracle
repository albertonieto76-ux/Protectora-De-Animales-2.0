# Dominio publico apuntando a la IP de la instancia de Oracle Cloud.
APP_DOMAIN=protectora.example.com
CORS_ORIGINS=https://protectora.example.com

POSTGRES_DB=protectora
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Genera valores distintos con: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
MFA_ENCRYPTION_KEY=replace-with-another-long-random-secret
ADMIN_BOOTSTRAP_KEY=replace-with-a-bootstrap-key