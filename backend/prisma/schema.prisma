generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  }

model Animal {
  id          Int      @id @default(autoincrement())
  name        String
  species     String
  age         Int?
  description String?
  images      String[]   @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  solicitudes SolicitudAdopcion[]
}

model SolicitudAdopcion {
  id        Int      @id @default(autoincrement())
  animalId  Int
  nombre    String
  email     String
  telefono  String?
  mensaje   String?
  estado    String   @default("pendiente")
  fechaCita DateTime?
  createdAt DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
}

model Voluntario {
  id             Int      @id @default(autoincrement())
  nombre         String
  email          String
  telefono       String?
  disponibilidad String?
  mensaje        String?
  createdAt      DateTime @default(now())
  citas          CitaVoluntariado[]
}

model CitaVoluntariado {
  id           Int        @id @default(autoincrement())
  voluntarioId Int
  inicio       DateTime
  fin          DateTime
  estado       String     @default("confirmada")
  notas        String?
  createdAt    DateTime   @default(now())

  voluntario Voluntario @relation(fields: [voluntarioId], references: [id], onDelete: Cascade)

  @@index([inicio])
  @@index([voluntarioId, inicio])
}

model Evento {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  fecha       DateTime
  lugar       String?
  images      String[] @default([])
  createdAt   DateTime @default(now())

  asistentes AsistenteEvento[]
}

model AsistenteEvento {
  id        Int      @id @default(autoincrement())
  eventoId  Int
  nombre    String
  email     String
  telefono  String?
  mensaje   String?
  createdAt DateTime @default(now())

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([eventoId])
  @@index([email])
}

model Donacion {
  id            Int       @id @default(autoincrement())
  cantidad      Float
  nombre        String?
  email         String?
  metodoId      Int?
  metodo        TipoPago? @relation(fields: [metodoId], references: [id])
  tipoDonacion  String?
  createdAt     DateTime @default(now())
}

model TipoPago {
  id         Int         @id @default(autoincrement())
  tipo       String      @unique
  label      String
  account    String?
  donaciones Donacion[]
}

model Usuario {
  id            Int     @id @default(autoincrement())
  nombre        String
  email         String  @unique
  password      String
  role          String  @default("user") // "admin" o "user"
  mfaEnabled    Boolean @default(false)
  mfaSecret     String?
  mfaTempSecret String?
  mfaRecoveryCodes String[] @default([])
}

model SecurityAuditLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId    Int?
  email     String?
  action    String
  success   Boolean
  ip        String?
  userAgent String?
  path      String?
  method    String?
  reason    String?
  metadata  Json?

  @@index([createdAt])
  @@index([action])
  @@index([userId])
}
