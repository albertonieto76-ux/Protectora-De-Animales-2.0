{
  "name": "protectora-backend",
  "version": "1.0.0",
  "type": "module",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "seed:admin": "tsx scripts/seedAdmin.ts",
    "images:migrate-to-db": "tsx scripts/migrateImagesToDb.ts",
    "images:migrate-to-db:clean": "tsx scripts/migrateImagesToDb.ts --clean",
    "seed:load-test": "tsx scripts/seedLoadTestData.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest --config src/vitest.config.ts --run src/tests --exclude \"src/tests/integration/**\" --exclude \"src/tests/e2e/**\" --exclude \"src/tests/docker/**\" --exclude \"src/tests/e2e-from-old-project.test.ts\" --exclude \"src/tests/integration-from-old-project.test.ts\" --exclude \"src/tests/integration.test.ts\"",
    "test:integration": "vitest --config src/vitest.config.ts --run src/tests/integration",
    "test:e2e": "vitest --config src/vitest.config.ts --run src/tests/e2e src/tests/e2e-from-old-project.test.ts",
    "test:docker:smoke": "vitest --config src/vitest.config.ts --run src/tests/docker",
    "test:docker": "npm run test:docker:smoke && npm run test",
    "coverage": "vitest --config src/vitest.config.ts run --coverage"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.8.0",
    "@prisma/config": "^7.9.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.1.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.7",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true,
    "esbuild@0.28.1": true
  }
}
