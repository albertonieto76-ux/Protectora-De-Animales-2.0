{
  "name": "protectora-backend",
  "version": "1.0.0",
  "type": "module",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "test": "vitest",
    "test:unit": "vitest --run src/tests/unit",
    "test:integration": "vitest --run src/tests/integration",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.8.0",
    "@prisma/config": "^7.9.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.1",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.1.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.7",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
