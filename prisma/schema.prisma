generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Animal {
  id          Int      @id @default(autoincrement())
  name        String
  species     String
  age         Int?
  description String?
  images      String[]   @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  solicitudes SolicitudAdopcion[]
}

model SolicitudAdopcion {
  id        Int      @id @default(autoincrement())
  animalId  Int
  nombre    String
  email     String
  telefono  String?
  mensaje   String?
  estado    String   @default("pendiente")
  createdAt DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
}

model Voluntario {
  id             Int      @id @default(autoincrement())
  nombre         String
  email          String
  telefono       String?
  disponibilidad String?
  mensaje        String?
  createdAt      DateTime @default(now())
}

model Evento {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  fecha       DateTime
  lugar       String?
  createdAt   DateTime @default(now())
}

model Donacion {
  id        Int      @id @default(autoincrement())
  cantidad  Float
  nombre    String?
  email     String?
  metodoId  Int
  metodo    TipoPago @relation(fields: [metodoId], references: [id])
  createdAt DateTime @default(now())
}

model TipoPago {
  id        Int        @id @default(autoincrement())
  tipo      String     @unique
  label     String
  donaciones Donacion[]
}

model Usuario {
  id        Int     @id @default(autoincrement())
  nombre    String
  email     String  @unique
  password  String
  role      String  @default("user") // "admin" o "user"
}
